---
const { href = "/contact", label = "Book a Free Strategy Call" } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-2
         rounded-full
         bg-white
         border border-[#9CABC3]
         pl-5 pr-2 py-2
         font-Poppins font-semibold
         text-[15px] leading-[100%] tracking-normal
         text-[#9CABC3]"
>
  {label}
  <span
    class="inline-flex h-8 w-8 items-center justify-center
           rounded-full bg-[#0f2147] text-white"
  >
    <!-- &#8599; -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 17L17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </span>
</a>
