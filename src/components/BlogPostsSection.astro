

---
import { fetchPosts, getFeaturedImageUrl } from "../lib/wp";

const posts = await fetchPosts();

const stripHtml = (html: string) => html.replace(/<[^>]*>/g, "").trim();
const words = (text: string) => text.split(/\s+/).filter(Boolean).length;
const readTime = (html: string) =>
    Math.max(1, Math.round(words(stripHtml(html)) / 200));
const formatExcerpt = (html: string) => {
    const originalText = stripHtml(html);
    const text = originalText
        .replace(/\s*\[?&hellip;]?\s*$/i, "")
        .replace(/\s*This is a substantial change\b.*$/i, "")
        .trim();

    const maxWords = 28;
    const parts = text.split(/\s+/).filter(Boolean);

    if (parts.length <= maxWords) {
        return text || originalText;
    }

    return `${parts.slice(0, maxWords).join(" ")}...`;
};
const getPrimaryCategory = (post: any) =>
    post?._embedded?.["wp:term"]?.[0]?.[0]?.name ?? "Finance";

    
