---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import {
    fetchAllSlugs,
    fetchPostBySlug,
    getFeaturedImageUrl,
} from "../../lib/wp";

export async function getStaticPaths() {
    const slugs = await fetchAllSlugs();
    return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await fetchPostBySlug(slug);

if (!post) {
    throw new Error(`Post not found: ${slug}`);
}

const featuredImage = getFeaturedImageUrl(post);
const stripHtml = (html: string) => html.replace(/<[^>]*>/g, "").trim();
const formatDate = (dateStr: string) =>
    new Date(dateStr).toLocaleString("en-US", {
        month: "short",
        year: "numeric",
    });
---

<Layout>
    <Fragment slot="header">
        <Header />
    </Fragment>

    <section class="bg-white">
        <div class="mx-auto max-w-6xl px-6 pt-10">
            <nav
                aria-label="Breadcrumb"
                class="flex items-center gap-3 font-Arial text-[16px] leading-[20px] tracking-[0px] text-[#6B7A93]"
            >
                <a href="/" class="hover:text-primary">Home</a>
                <span class="text-[#C7D0E0]">&#62;</span>
                <a href="/blog" class="hover:text-primary">Blog</a>
                <span class="text-[#C7D0E0]">&#62;</span>
                <span class="text-[#1E2E4A]"
                    >{stripHtml(post.title.rendered)}</span
                >
            </nav>
        </div>

        <div class="mx-auto max-w-4xl px-6 py-10 lg:py-16">
            <h1
                class="font-Arial text-[30px] font-bold leading-[40px] text-[#1E2E4A] sm:text-[38px] sm:leading-[46px] lg:text-[44px] lg:leading-[54px]"
            >
                {stripHtml(post.title.rendered)}
            </h1>
            <div
                class="mt-4 font-Arial text-[14px] leading-[22px] text-[#8A97AD]"
            >
                {formatDate(post.date)}
            </div>

            {
                featuredImage ? (
                    <div class="mt-8 overflow-hidden rounded-[24px]">
                        <img
                            src={featuredImage}
                            alt={stripHtml(post.title.rendered)}
                            class="h-full w-full object-cover"
                        />
                    </div>
                ) : null
            }

            <article class="wp-content mt-8 max-w-none">
                <div set:html={post.content.rendered} />
            </article>
        </div>
    </section>

    <section class="bg-white pb-12 lg:pb-20">
        <div class="mx-auto max-w-6xl px-6 md:px-14 lg:px-6">
            <div
                class="rounded-[28px] bg-[#16264D] px-6 py-12 text-center text-white shadow-[0_30px_60px_-25px_rgba(15,40,71,0.45)] px-10 lg:px-20 lg:py-20"
            >
                <h2
                    class="font-Arial font-bold
         lg:text-[40px] text-[25px] lg:leading-[54.62px]
         tracking-[0px] text-center"
                >
                    Make Better Financial Decisions
                </h2>
                <p
                    class="mx-auto font-Arial text-[15px] leading-[26px] text-white/80 lg:text-[16px] sm:leading-[28px]"
                >
                    Monthly loan tips, credit score improvement advice, and
                    smart money strategies - simple and practical.
                </p>

                <div
                    class="mt-8 flex flex-wrap text-center items-center justify-center gap-4"
                >
                    <a
                        href="mailto:keyur@SAIFinance.com.au"
                        class="flex justify-center items-center lg:w-full lg:max-w-[320px] gap-3 rounded-xl bg-white px-2 lg:px-5 py-2 text-[#1E2E4A] w-[300px]"
                    >
                        <span
                            class="font-Arial font-normal text-[17px] leading-[31.86px] tracking-[0px] text-center text-[#14254A]"
                        >
                            Enter your business email
                        </span>

                        <span class="text-[#1E2E4A]">&#8594;</span>
                    </a>

                    <a
                        href="/contact"
                        class="inline-flex items-center justify-center gap-2
         rounded-xl border border-white/70
         px-7 py-2
         font-Arial font-normal
         text-[17px] leading-[35px]
         tracking-[0px] text-white
         text-center
         hover:bg-white/10 transition-colors duration-200 w-[300px]"
                    >
                        Get Finance Tips
                        <span>&#8594;</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <Fragment slot="footer">
        <Footer />
    </Fragment>
</Layout>

<style>
    .wp-content {
        font-family: "Arial", sans-serif;
        color: #2d3b52;
        font-size: 17px;
        line-height: 1.8;
        letter-spacing: 0;
        word-break: break-word;
    }

    .wp-content :global(p),
    .wp-content :global(li) {
        margin: 0 0 1rem;
        font-size: 1rem;
        line-height: 1.8;
    }

    .wp-content :global(h1),
    .wp-content :global(.wp-block-heading.is-style-default.h1) {
        margin: 2.25rem 0 1rem;
        color: #1e2e4a;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.2;
        font-weight: 700;
    }

    .wp-content :global(h2),
    .wp-content :global(.wp-block-heading.h2) {
        margin: 2rem 0 0.9rem;
        color: #1e2e4a;
        font-size: clamp(1.55rem, 3vw, 2.15rem);
        line-height: 1.25;
        font-weight: 700;
    }

    .wp-content :global(h3),
    .wp-content :global(.wp-block-heading.h3) {
        margin: 1.6rem 0 0.75rem;
        color: #1e2e4a;
        font-size: clamp(1.25rem, 2vw, 1.5rem);
        line-height: 1.3;
        font-weight: 700;
    }

    .wp-content :global(h4),
    .wp-content :global(h5),
    .wp-content :global(h6) {
        margin: 1.4rem 0 0.7rem;
        color: #1e2e4a;
        font-weight: 700;
        line-height: 1.35;
    }

    .wp-content :global(strong),
    .wp-content :global(b) {
        font-weight: 700;
        color: #1e2e4a;
    }

    .wp-content :global(a) {
        color: #14254a;
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }

    .wp-content :global(ul),
    .wp-content :global(ol) {
        margin: 0 0 1rem;
        padding-left: 1.35rem;
    }

    .wp-content :global(ul) {
        list-style: disc;
    }

    .wp-content :global(ol) {
        list-style: decimal;
    }

    .wp-content :global(li) {
        margin-bottom: 0.45rem;
    }

    .wp-content :global(blockquote) {
        margin: 1.5rem 0;
        padding: 1rem 1.2rem;
        border-left: 4px solid #c7d0e0;
        background: #f8fbff;
        color: #4b5d78;
        font-style: italic;
    }

    .wp-content :global(img),
    .wp-content :global(figure) {
        max-width: 100%;
    }

    .wp-content :global(figure) {
        margin: 1.75rem 0;
    }

    .wp-content :global(figure img),
    .wp-content :global(.wp-block-image img) {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 1rem;
    }

    .wp-content :global(.wp-block-image figcaption),
    .wp-content :global(figcaption) {
        margin-top: 0.65rem;
        font-size: 0.875rem;
        line-height: 1.5;
        color: #6b7a93;
        text-align: center;
    }

    .wp-content :global(hr) {
        margin: 2rem 0;
        border: 0;
        border-top: 1px solid #dbe4f2;
    }

    .wp-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.95rem;
    }

    .wp-content :global(th),
    .wp-content :global(td) {
        border: 1px solid #dbe4f2;
        padding: 0.75rem 0.9rem;
        text-align: left;
        vertical-align: top;
    }

    .wp-content :global(th) {
        background: #f4f7fc;
        font-weight: 700;
        color: #1e2e4a;
    }

    .wp-content :global(.wp-block-spacer) {
        margin: 0;
    }

    .wp-content > :global(*:first-child) {
        margin-top: 0;
    }

    .wp-content > :global(*:last-child) {
        margin-bottom: 0;
    }
</style>
