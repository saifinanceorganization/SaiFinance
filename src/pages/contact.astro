---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

const wpApiUrl = (import.meta.env.PUBLIC_WP_API_URL || "").trim();
const wpBaseUrl = (
    import.meta.env.PUBLIC_CF7_BASE_URL ||
    (wpApiUrl ? wpApiUrl.replace(/\/wp-json\/wp\/v2\/?$/i, "") : "")
).trim();

const cf7EndpointOverride = (import.meta.env.PUBLIC_CF7_ENDPOINT || "").trim();
const cf7FormId = (import.meta.env.PUBLIC_CF7_FORM_ID || "").toString().trim();
const turnstileSiteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "").trim();
const currentHostname = Astro.url.hostname;

const hasValidCf7FormId = cf7FormId.length > 0;
const hasTurnstileSiteKey = turnstileSiteKey.length > 0;
const isLocalHost =
    currentHostname === "localhost" ||
    currentHostname === "127.0.0.1" ||
    currentHostname === "0.0.0.0" ||
    currentHostname === "::1";
const shouldRenderTurnstile = hasTurnstileSiteKey && !isLocalHost;

const cf7Endpoint =
    cf7EndpointOverride ||
    (wpBaseUrl && hasValidCf7FormId
        ? `${wpBaseUrl}/wp-json/contact-form-7/v1/contact-forms/${encodeURIComponent(
              cf7FormId,
          )}/feedback`
        : "");
---

<Layout title="Contact US | SAI Finance">
    <Fragment slot="header">
        <Header />
    </Fragment>

    <section class="bg-[#f6f7fb]">
        <div
            class="mx-auto max-w-4xl px-6 py-16 text-center md:px-14 lg:px-6 lg:py-24"
        >
            <h1
                class="bg-primary bg-clip-text text-center font-Arial text-[25px] font-bold leading-[35px] tracking-normal text-transparent lg:text-[40px] lg:leading-[48px]"
            >
                Get in Touch
            </h1>

            <p
                class="mt-3 text-center font-Arial text-[16px] font-normal leading-[24px] tracking-normal text-[#4A5565]"
            >
                We&apos;d love to hear from you. Send us a message and we&apos;ll
                respond as<br /> soon as possible.
            </p>
        </div>
    </section>

    <section class="bg-[#f6f7fb] pb-20">
        <div class="mx-auto max-w-5xl px-6 md:px-14 lg:px-6">
            <form
                id="contact-form"
                class="rounded-[24px] border border-[#203A6E] bg-white px-10 py-10 shadow-sm md:px-16 md:py-16"
                action={cf7Endpoint}
                method="post"
                enctype="multipart/form-data"
                data-cf7-base-url={wpBaseUrl}
                data-cf7-endpoint={cf7EndpointOverride}
                data-cf7-form-id={cf7FormId}
                data-turnstile-enabled={shouldRenderTurnstile ? "true" : "false"}
                novalidate
            >
                <div
                    class="mb-6 hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-[14px] leading-6 text-red-800"
                    data-message="error"
                    aria-live="polite"
                >
                    Something went wrong. Please try again.
                </div>

                <div class="grid gap-8 md:grid-cols-2">
                    <div class="flex flex-col gap-3" data-field="your-name">
                        <input
                            id="name"
                            name="your-name"
                            type="text"
                            autocomplete="name"
                            class="border-b border-[#D6DBE3] bg-transparent pb-5 font-Arial text-[16px] text-[#99A1AF] outline-none placeholder:text-[#8A93A8]"
                            placeholder="Your Name"
                        />
                        <span
                            class="hidden text-[12px] text-red-600"
                            data-error="your-name"
                        ></span>
                    </div>

                    <div class="flex flex-col gap-3" data-field="your-email">
                        <input
                            id="email"
                            name="your-email"
                            type="email"
                            required
                            autocomplete="email"
                            class="border-b border-[#D6DBE3] bg-transparent pb-5 font-Arial text-[16px] text-[#99A1AF] outline-none placeholder:text-[#8A93A8]"
                            placeholder="Email Address"
                        />
                        <span
                            class="hidden text-[12px] text-red-600"
                            data-error="your-email"
                        ></span>
                    </div>
                </div>

                <div class="mt-12 flex flex-col gap-3" data-field="tel-53">
                    <input
                        id="phone"
                        name="tel-53"
                        type="tel"
                        required
                        autocomplete="tel"
                        class="border-b border-[#D6DBE3] bg-transparent pb-5 font-Arial text-[16px] text-[#99A1AF] outline-none placeholder:text-[#8A93A8]"
                        placeholder="Phone Number"
                    />
                    <span
                        class="hidden text-[12px] text-red-600"
                        data-error="tel-53"
                    ></span>
                </div>

                <div class="mt-8 flex flex-col gap-3" data-field="your-message">
                    <textarea
                        id="message"
                        name="your-message"
                        rows="4"
                        class="border-b border-[#D6DBE3] bg-transparent pb-5 font-Arial text-[16px] text-[#99A1AF] outline-none placeholder:text-[#8A93A8]"
                        placeholder="Your Message"
                    ></textarea>
                    <span
                        class="hidden text-[12px] text-red-600"
                        data-error="your-message"
                    ></span>
                </div>

                <input type="hidden" name="_wpcf7" id="wpcf7-id" value={cf7FormId} />
                <input
                    type="hidden"
                    name="_wpcf7_version"
                    id="wpcf7-version"
                    value="5.9.8"
                />
                <input
                    type="hidden"
                    name="_wpcf7_locale"
                    id="wpcf7-locale"
                    value="en_US"
                />
                <input
                    type="hidden"
                    name="_wpcf7_unit_tag"
                    id="wpcf7-unit-tag"
                    value=""
                />
                <input
                    type="hidden"
                    name="_wpcf7_container_post"
                    id="wpcf7-container-post"
                    value="0"
                />

                {shouldRenderTurnstile && (
                    <div class="mt-6 flex justify-start">
                        <div
                            class="cf-turnstile"
                            data-sitekey={turnstileSiteKey}
                            data-theme="light"
                        ></div>
                    </div>
                )}

                <div class="mt-6 hidden text-[13px] text-red-600" data-error="submit">
                    Something went wrong. Please try again.
                </div>

                <div class="mt-14 flex justify-end">
                    <button
                        type="submit"
                        data-submit-button
                        class="inline-flex items-center justify-center gap-3 rounded-full bg-primary px-8 py-3 font-Arial font-normal text-[15px] leading-[28px] tracking-normal text-center text-white"
                    >
                        <span data-submit-label>Send Message</span>
                        <span
                            class="hidden text-[20px]"
                            data-submit-spinner
                            aria-hidden="true"
                        >
                            &#8635;
                        </span>
                        <span class="text-[20px]">&#8594;</span>
                    </button>
                </div>
            </form>

            <div
                id="contact-thankyou"
                class="hidden rounded-[24px] border border-[#203A6E] bg-white px-10 py-14 text-center shadow-sm md:px-16 md:py-16"
            >
                <h2
                    class="font-Arial text-[24px] font-bold leading-[32px] text-primary"
                >
                    Thank you
                </h2>
                <p class="mt-3 font-Arial text-[16px] leading-[26px] text-[#4A5565]">
                    Thank you for your message. We will get back to you soon.
                </p>
            </div>
        </div>
    </section>

    <Fragment slot="footer">
        <Footer />
    </Fragment>
</Layout>

{shouldRenderTurnstile && (
    <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
    ></script>
)}

<script is:inline>
    (() => {
        const form = document.getElementById("contact-form");
        const thankYou = document.getElementById("contact-thankyou");
        const turnstileEnabled = form?.dataset.turnstileEnabled === "true";

        if (!form || !thankYou) return;

        const errorMessage = form.querySelector('[data-message="error"]');
        const submitAlert = form.querySelector('[data-error="submit"]');
        const submitButton = form.querySelector("[data-submit-button]");
        const submitLabel = form.querySelector("[data-submit-label]");
        const submitSpinner = form.querySelector("[data-submit-spinner]");
        const turnstileResponseField = () =>
            form.querySelector(
                'textarea[name="cf-turnstile-response"], input[name="cf-turnstile-response"]',
            );

        const clearMessages = () => {
            [errorMessage, submitAlert].forEach((node) => {
                if (!node) return;
                node.classList.add("hidden");
            });
        };

        const clearFieldErrors = () => {
            form.querySelectorAll("[data-field]").forEach((field) => {
                field.classList.remove("border-red-400");
            });

            form.querySelectorAll("[data-error]").forEach((error) => {
                if (error.getAttribute("data-error") === "submit") return;
                error.textContent = "";
                error.classList.add("hidden");
            });

            form.querySelectorAll("[aria-invalid='true']").forEach((input) => {
                input.removeAttribute("aria-invalid");
            });
        };

        const setLoading = (isLoading) => {
            if (submitButton instanceof HTMLButtonElement) {
                submitButton.disabled = isLoading;
                submitButton.classList.toggle("opacity-70", isLoading);
                submitButton.classList.toggle("cursor-not-allowed", isLoading);
            }

            if (submitLabel) {
                submitLabel.textContent = isLoading ? "Sending..." : "Send Message";
            }

            if (submitSpinner) {
                submitSpinner.classList.toggle("hidden", !isLoading);
            }
        };

        const showThankYou = () => {
            form.reset();
            form.classList.add("hidden");
            thankYou.classList.remove("hidden");
            thankYou.scrollIntoView({
                behavior: "smooth",
                block: "start",
            });
        };

        const showTurnstileError = () => {
            if (!submitAlert) return;
            submitAlert.textContent =
                "Please complete the security check before sending your message.";
            submitAlert.classList.remove("hidden");
        };

        const buildEndpoint = () => {
            const override = form.dataset.cf7Endpoint?.trim();
            if (override) {
                return new URL(override, window.location.href).toString();
            }

            const baseUrl = form.dataset.cf7BaseUrl?.trim();
            const formId = form.dataset.cf7FormId?.trim();

            if (!baseUrl || !formId) return "";

            const url = new URL(baseUrl, window.location.href);
            url.pathname = `/wp-json/contact-form-7/v1/contact-forms/${encodeURIComponent(
                formId,
            )}/feedback`;
            url.search = "";
            url.hash = "";
            return url.toString();
        };

        const showFieldError = (fieldName, message) => {
            const field = form.querySelector(`[data-field="${fieldName}"]`);
            const error = form.querySelector(`[data-error="${fieldName}"]`);
            const input = form.querySelector(`[name="${fieldName}"]`);

            if (field) field.classList.add("border-red-400");
            if (input) input.setAttribute("aria-invalid", "true");
            if (error) {
                error.textContent = message;
                error.classList.remove("hidden");
            }
        };

        const extractFieldName = (item) => {
            const into = item?.into ?? "";
            const wrapMatch = into.match(
                /\.wpcf7-form-control-wrap\.([A-Za-z0-9_-]+)/,
            );

            if (wrapMatch?.[1]) return wrapMatch[1];

            const fieldMatch = into.match(/\[name=['"]?([^'"\]]+)['"]?\]/);
            return fieldMatch?.[1] ?? "";
        };

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            clearMessages();
            clearFieldErrors();
            setLoading(true);

            const endpoint = buildEndpoint();

            if (!endpoint) {
                if (submitAlert) {
                    submitAlert.textContent =
                        "Contact form endpoint is missing. Check the WordPress settings.";
                    submitAlert.classList.remove("hidden");
                }
                setLoading(false);
                return;
            }

            const formData = new FormData(form);
            const formId = form.dataset.cf7FormId?.trim() || "0";

            if (turnstileEnabled && !turnstileResponseField()?.value) {
                showTurnstileError();
                setLoading(false);
                return;
            }

            if (!formData.get("_wpcf7")) {
                formData.set("_wpcf7", formId);
            }

            if (!formData.get("_wpcf7_version")) {
                formData.set("_wpcf7_version", "5.9.8");
            }

            if (!formData.get("_wpcf7_locale")) {
                formData.set("_wpcf7_locale", document.documentElement.lang || "en_US");
            }

            if (!formData.get("_wpcf7_unit_tag")) {
                formData.set(
                    "_wpcf7_unit_tag",
                    `wpcf7-f${formId}-p0-o${Date.now().toString(36).slice(-8)}`,
                );
            }

            if (!formData.get("_wpcf7_container_post")) {
                formData.set("_wpcf7_container_post", "0");
            }

            try {
                const endpointUrl = new URL(endpoint, window.location.href);
                const sameOrigin = endpointUrl.origin === window.location.origin;

                if (!sameOrigin) {
                    await fetch(endpoint, {
                        method: "POST",
                        body: formData,
                        mode: "no-cors",
                    });

                    showThankYou();
                    return;
                }

                const response = await fetch(endpoint, {
                    method: "POST",
                    body: formData,
                    credentials: "include",
                    headers: {
                        Accept: "application/json",
                    },
                });

                const data = await response.json().catch(() => null);
                const status = data?.status || "";
                const isSuccess = response.ok && (status === "mail_sent" || status === "mail_failed");

                if (!isSuccess) {
                    if (Array.isArray(data?.invalid_fields)) {
                        data.invalid_fields.forEach((item) => {
                            const fieldName = extractFieldName(item);
                            if (fieldName) {
                                showFieldError(
                                    fieldName,
                                    item?.message || "Please check this field.",
                                );
                            }
                        });
                    }

                    if (submitAlert) {
                        submitAlert.textContent =
                            status === "spam"
                                ? "WordPress marked this submission as spam. Check your Contact Form 7 anti-spam settings."
                                : data?.message || "Something went wrong. Please try again.";
                        submitAlert.classList.remove("hidden");
                    }
                    return;
                }

                showThankYou();
            } catch (error) {
                if (submitAlert) {
                    submitAlert.textContent =
                        "Unable to send your message right now. Please try again later.";
                    submitAlert.classList.remove("hidden");
                }
                console.error("Contact form submission failed", error);
            } finally {
                setLoading(false);
            }
        });
    })();
</script>
