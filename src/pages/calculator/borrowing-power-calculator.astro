  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://saifinance.com.au/calculator/borrowing-power-calculator/#webpage",
      url: "https://saifinance.com.au/calculator/borrowing-power-calculator/",
      name: "Borrowing Power Calculator Australia | SAI Finance",
      description:
        "Estimate how much you may be able to borrow for a home loan based on your income, expenses and financial commitments using SAI Finance's Borrowing Power Calculator.",
      isPartOf: {
        "@id": "https://saifinance.com.au/#website",
      },
      publisher: {
        "@id": "https://saifinance.com.au/#organization",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://saifinance.com.au/#website",
      url: "https://saifinance.com.au/",
      name: "SAI Finance",
      publisher: {
        "@id": "https://saifinance.com.au/#organization",
      },
    },
    {
      "@type": "Organization",
      "@id": "https://saifinance.com.au/#organization",
      name: "SAI Finance",
      url: "https://saifinance.com.au/",
      logo: {
        "@type": "ImageObject",
        url: "https://saifinance.com.au/wp-content/uploads/logo.png",
      },
      email: "keyur@saifinance.com.au",
      telephone: "+61-433-967-374",
    },
    {
      "@type": "SoftwareApplication",
      "@id":
        "https://saifinance.com.au/calculator/borrowing-power-calculator/#calculator",
      name: "Borrowing Power Calculator",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Web Browser",
      description:
        "A calculator that estimates home loan borrowing capacity based on income, expenses and liabilities.",
      url: "https://saifinance.com.au/calculator/borrowing-power-calculator/",
