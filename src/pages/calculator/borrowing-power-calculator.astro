---

<Layout title={title} description={description} keywords={keywords}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(borrowingcalculatorSchema)} />
  </Fragment>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <BorrowingPowerCalculator client:load />

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</Layout>
