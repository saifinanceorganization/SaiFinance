---
import HomeLoanCalculators from "../../components/HomeLoanCalculators.vue";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";

const title = "Loan Repayment Calculator Australia | Estimate Repayments";
const description =
  "Loan repayment calculator helping Australians estimate monthly repayments, compare loan options, understand interest costs and plan finances with confidence.";
const keywords =
  "Loan repayment calculator, Home loan repayment calculator, House loan repayment calculator, Loan repayments Calculator, Loan Calculator Repayment, Car loan repayment Calculator ";

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://saifinance.com.au/#website",
      url: "https://saifinance.com.au/",
      name: "SAI Finance",
    },
    {
      "@type": "Organization",
      "@id": "https://saifinance.com.au/#organization",
      name: "SAI Finance",
      url: "https://saifinance.com.au/",
      telephone: "+61 433 967 374",
      email: "keyur@saifinance.com.au",
    },
    {
      "@type": "WebPage",
      "@id":
        "https://saifinance.com.au/calculator/loan-repayment-calculator/#webpage",
      url: "https://saifinance.com.au/calculator/loan-repayment-calculator/",
      name: "Loan Repayment Calculator",
      description:
        "Calculate your estimated home loan repayments, interest costs and loan payoff timeline using the SAI Finance Loan Repayment Calculator.",
      isPartOf: {
        "@id": "https://saifinance.com.au/#website",
      },
      about: {
        "@id":
          "https://saifinance.com.au/calculator/loan-repayment-calculator/#calculator",
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id":
        "https://saifinance.com.au/calculator/loan-repayment-calculator/#calculator",
      name: "Loan Repayment Calculator",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Web Browser",
      url: "https://saifinance.com.au/calculator/loan-repayment-calculator/",
      description:
        "Online calculator that estimates mortgage repayments, total interest payable and loan term outcomes based on loan amount, interest rate and repayment frequency.",
      provider: {
        "@id": "https://saifinance.com.au/#organization",
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "AUD",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://saifinance.com.au/calculator/loan-repayment-calculator/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://saifinance.com.au/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Calculators",
          item: "https://saifinance.com.au/calculators/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Loan Repayment Calculator",
          item: "https://saifinance.com.au/calculator/loan-repayment-calculator/",
        },
      ],
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  </Fragment>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Home Loan Calculators</title>
    </head>
    <body>
      <main class="page-shell">
        <HomeLoanCalculators
          client:load
          ownerOccupiedRate={6.19}
          investmentRate={6.49}
          repaymentDefaultRate={6.19}
          compareRate={6.89}
        />
      </main>
    </body>
  </html>

  <style is:global>
    :root {
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      color: #101828;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
    }

    .page-shell {
      padding: 0px 20px 0px;
    }
  </style>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</Layout>
