---
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import ServiceLayout from "../../components/ServiceLayout.astro";

const data = {
    breadcrumb: [
        { label: "Home", href: "/" },
        { label: "Services", href: "/services" },
        { label: "Home Loan" },
    ],
    heroTitle: "Home Loan",
    heroSubtitle:
        "Your journey to owning a home starts with clarity, confidence, and the right lending partner.",
    heroImage: "/img/services_hero.webp",
    heroImageAlt: "Home loan services with flexible finance and expert guidance",
    heroCtaPrimaryText: "Apply for Home Loan",
    heroCtaSecondaryText: "Book a Free Call",
    aboutTitle: "Home Buyers",
    aboutText: [
        "Buying a home is one of the biggest milestones in life. Whether you are stepping into the market for the first time or upgrading to a home that better suits your family, the process can feel overwhelming.",
        "At SAI Finance, we make it simpler, clearer, and far less stressful by guiding you through every step - from understanding your borrowing power to securing the right loan structure for your goals.",
        "Our approach is personal. We take the time to understand your situation, your plans, and what home means for you. Then we match you with lending options that support your long-term financial wellbeing.",
    ],
    aboutImage: "/img/service_home.png",
    aboutImageAlt:
        "Home loan solutions for buying, refinancing or investing in property",
    benefitsTitle: "How SAI Finance Helps",
    benefits: [
        "We find the right loan for you - We compare your goals with thousands of lending options across major banks and specialist lenders.",
        "We negotiate on your behalf - Our relationships with lenders help us secure sharper rates and tailored offers.",
        "We handle the paperwork - From application to settlement, we manage the details so you can focus on your home.",
        "Our service is free - You do not pay us; the lender you choose pays our fee.",
    ],
    calculators: [
        {
            title: "Calculate Your Borrowing Power",
            description:
                "Find out how much you can borrow based on your income, expenses, and financial situation.",
            href: "/calculator/borrowing-power-calculator",
        },
        {
            title: "Calculate Repayment Options",
            description:
                "Explore different repayment scenarios and find the loan structure that works best for your budget.",
            href: "/calculator/loan-repayment-calculator",
        },
    ],
    servicesTitle: "Understanding Your Home Loan Options",
    servicesSubtitle:
        "From deposits to guarantees and government grants - we guide you through every option available.",
    services: [
        {
            title: "First-Home Buyers",
            description:
                "Taking the first step into the property market is easier with clear, personalised support. We break down your deposit needs, borrowing capacity, government incentives, and pre‑approval requirements, and manage the process with your agent and solicitor from start to finish.",
            icon: "ph:house-line",
            iconAlt: "First Home Buyers",
        },
        {
            title: "How Much Deposit Do You Need?",
            description:
                "Your deposit options are more flexible than most people realise. Whether you’re borrowing up to 95%, combining savings, or using a Family Guarantee, we explain the pros, cons, and long‑term impact so you can move forward with confidence.",
            icon: "ph:piggy-bank",
            iconAlt: "Deposit planning",
        },
        {
            title: "Family Guarantee",
            description:
                "A Family Guarantee can fast‑track your home purchase by using a parent’s equity to lower your LVR, avoid LMI, and increase how much you can borrow. We walk you through the process and make sure the arrangement is secure and fair for everyone.",
            icon: "ph:hand-heart",
            iconAlt: "Family support guarantee",
        },
        {
            title: "First Home Owner Grant (FHOG)",
            description:
                "What you can access depends on your state.Each state and territory has different eligibility rules and grant amounts. We’ll help you check what applies to you and ensure your application is completed correctly.",
            icon: "ph:certificate",
            iconAlt: "First Home Owner Grant",
        },
    ],
    ctaTitle: "Ready to Apply for Your First Home Loan?",
    ctaSubtitle:
        "Take the first step towards homeownership today with expert guidance from SAI Finance.",
    ctaPrimaryText: "Apply Now",
    ctaSecondaryText: "Book Free Call",
};

const title = "Home Loans Australia | Competitive Rates & Expert Help";
const description =
    "Tailored home loans for first home buyers, refinancers, and property owners in Australia, offering competitive rates and expert support.";
const keywords =
    "Home loans, Home loan broker, Home loan broker near me, Home Loan Solutions, Home loan broker Brisbane, Home Finance";

const homeloanSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": "https://saifinance.com.au/services/home-loan/#webpage",
            url: "https://saifinance.com.au/services/home-loan/",
            name: "Home Loan Services | SAI Finance",
            description:
                "SAI Finance helps Australians secure home loans with access to multiple lenders, competitive finance solutions and expert mortgage guidance.",
            inLanguage: "en-AU",
        },
        {
            "@type": "Service",
            "@id": "https://saifinance.com.au/services/home-loan/#service",
            name: "Home Loan Services",
            url: "https://saifinance.com.au/services/home-loan/",
            description:
                "Home loan solutions for first home buyers, owner occupiers, refinancers and property buyers across Australia.",
            serviceType: "Home Loan",
            areaServed: {
                "@type": "Country",
                name: "Australia",
            },
            audience: {
                "@type": "Audience",
                audienceType: "Home Buyers",
            },
            availableChannel: {
                "@type": "ServiceChannel",
                serviceUrl: "https://saifinance.com.au/services/home-loan/",
            },
        },
        {
            "@type": "FAQPage",
            "@id": "https://saifinance.com.au/services/home-loan/#faq",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "How much deposit do I need for a home loan in Australia?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Most lenders prefer a deposit of 20%, however some borrowers may be eligible to purchase a property with as little as a 5% deposit, subject to lender criteria.",
                    },
                },
                {
                    "@type": "Question",
                    name: "How much can I borrow for a home loan?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Your borrowing capacity depends on factors such as income, expenses, existing debts, credit history and the lender's assessment criteria.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Can I buy a house with a 5% deposit in Australia?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. Many lenders offer low-deposit home loans. Additional costs such as Lenders Mortgage Insurance may apply.",
                    },
                },
                {
                    "@type": "Question",
                    name: "What is Lenders Mortgage Insurance (LMI)?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "LMI is generally required when a borrower has less than a 20% deposit and helps protect the lender if the loan cannot be repaid.",
                    },
                },
                {
                    "@type": "Question",
                    name: "What is home loan pre-approval?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Pre-approval provides an indication of how much you may be able to borrow before purchasing a property, helping you understand your budget.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Can first home buyers get government assistance in Australia?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Eligible first home buyers may qualify for grants, stamp duty concessions and government-backed home guarantee schemes depending on their state or territory.",
                    },
                },
                {
                    "@type": "Question",
                    name: "What documents do I need to apply for a home loan?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Most lenders require proof of identity, income documents, bank statements, employment details and information about existing liabilities.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Can self-employed borrowers get a home loan?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. Self-employed applicants can apply for home loans by providing business financial records, tax returns and evidence of stable income.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is it better to choose a fixed or variable home loan?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "A fixed-rate loan offers repayment certainty, while a variable-rate loan provides flexibility and may allow borrowers to benefit from future rate reductions.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Why should I use SAI Finance for my home loan?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "SAI Finance works with multiple lenders across Australia to help borrowers compare loan options, navigate the application process and secure a home loan aligned with their financial goals.",
                    },
                },
                {
                    "@type": "Question",
                    name: "How does SAI Finance help first home buyers?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "SAI Finance provides personalised guidance throughout the home buying journey, helping first home buyers understand borrowing capacity, government incentives and suitable loan options.",
                    },
                },
                {
                    "@type": "Question",
                    name: "How long does the home loan approval process take?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Approval timeframes vary by lender and borrower circumstances. Pre-approval may take a few days, while formal approval may take one to several weeks.",
                    },
                },
            ],
        },
        {
            "@type": "BreadcrumbList",
            "@id": "https://saifinance.com.au/services/home-loan/#breadcrumb",
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "Home",
                    item: "https://saifinance.com.au/",
                },
                {
                    "@type": "ListItem",
                    position: 2,
                    name: "Services",
                    item: "https://saifinance.com.au/services/",
                },
                {
                    "@type": "ListItem",
                    position: 3,
                    name: "Home Loan",
                    item: "https://saifinance.com.au/services/home-loan/",
                },
            ],
        },
    ],
};
---

<Layout title={title} description={description} keywords={keywords}>
    <Fragment slot="head">
        <script
            type="application/ld+json"
            set:html={JSON.stringify(homeloanSchema)}
        />
    </Fragment>
    <Fragment slot="header">
        <Header />
    </Fragment>

    <ServiceLayout {...data} />

    <Fragment slot="footer">
        <Footer />
    </Fragment>
</Layout>
